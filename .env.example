# MAISON AMIRAL / server-only production settings. Never prefix with NEXT_PUBLIC.
MAISON_SITE_URL=http://localhost:3000
MAISON_SUPABASE_URL=
MAISON_SUPABASE_SERVICE_ROLE_KEY=
# Store-approved delivery amount in cents (e.g. 7000 is R70). 0 only if approved.
MAISON_DELIVERY_FEE_CENTS=

# Resend requires a verified sending domain.
RESEND_API_KEY=
MAISON_RESEND_FROM=orders@maisonamiral.co.za
MAISON_ORDER_EMAIL=

# Validated against the business bank statement before enabling checkout.
MAISON_BANK_NAME=
MAISON_BANK_ACCOUNT_HOLDER=
MAISON_BANK_ACCOUNT_NUMBER=
MAISON_BANK_BRANCH_CODE=
MAISON_BANK_ACCOUNT_TYPE=
