# Maison Amiral store (server-only; never NEXT_PUBLIC)
# Set local development values in .env.local (do not commit secrets).
MAISON_SITE_URL=http://localhost:3000
MAISON_SUPABASE_URL=
MAISON_SUPABASE_SERVICE_ROLE_KEY=

# Amount in cents, explicitly agreed with the business (e.g. 7000 for R70 delivery).
# Leave empty until the delivery fee has been confirmed.
MAISON_DELIVERY_FEE_CENTS=

# Yoco Checkout API: test keys first. Store these only on the server.
YOCO_SECRET_KEY=
YOCO_WEBHOOK_SECRET=
